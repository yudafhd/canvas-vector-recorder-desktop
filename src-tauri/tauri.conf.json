{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas Vector Recorder",
  "version": "1.1.0",
  "identifier": "com.canvasvectorrecorder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Canvas Vector Recorder", "width": 1280, "height": 820, "resizable": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' blob: data:; frame-src http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Record Canvas operations and export editable SVG",
    "longDescription": "A licensed desktop Canvas vector recorder.",
    "windows": { "wix": { "language": ["en-US"] } },
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0"] } }
  }
}
