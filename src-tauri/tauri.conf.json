{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas Vector Recorder",
  "version": "1.1.7",
  "identifier": "com.canvasvectorrecorder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Canvas Vector Recorder", "width": 1280, "height": 820, "maximized": true, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; frame-src http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Record Canvas operations and export editable SVG",
    "longDescription": "A licensed desktop Canvas vector recorder.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRkM0NzY4NDhBRDY0NDIKUldSQ1pLMUlhRWY4Y3d4NW40L0N5OG9Lc3FNQU1DTmNzSVY3c3RzWjNYV0pTd1ozeHZMREg4RHIK",
      "endpoints": [
        "https://github.com/yudafhd/canvas-vector-recorder-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
